  import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        String result = (a == b) ? "Equal" :
                        (a > b) ? String.valueOf(a) :
                        String.valueOf(b);

        System.out.println(result);

        sc.close();
    }
}

