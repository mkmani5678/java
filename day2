public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        String result = (Math.abs(n % 10) % 2 == 0)
                        ? "Yes" : "No";

        System.out.println(result);

        sc.close();
    }
}

